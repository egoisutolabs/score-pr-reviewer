# Provider: "anthropic" (default) or "zai" (Z.AI GLM via its OpenAI-compatible endpoint)
PR_REVIEWER_PROVIDER=anthropic
# Reasoning: off is ~5x faster on GLM (16 s vs 75 s per brief); on for hard PRs
PR_REVIEWER_THINKING=off

# Model id for the chosen provider (anthropic default: claude-opus-5; zai: glm-5.3)
PR_REVIEWER_MODEL=claude-opus-5

ANTHROPIC_API_KEY=

ZAI_API_KEY=
# Coding-plan keys use the /coding/ endpoint; pay-as-you-go keys use https://api.z.ai/api/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4

# Where the Next.js runtime finds the Python agent
AGENT_URL=http://localhost:8123

# CopilotKit runtime phones home by default
COPILOTKIT_TELEMETRY_DISABLED=true
